  },
  "contributors": [
    {
      "name": "EstebanForge",
      "email": "esteban@attitude.cl",
      "url": "https://actitud.xyz"
    }
  ],
  "homepage": "https://github.com/FireSpoonYZ/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/FireSpoonYZ/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
